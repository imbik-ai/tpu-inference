+def _decode_e2m1_bits(x_int4: jax.Array, dtype) -> jax.Array:
+  """e2m1 values from their bits held in an int4 vector (sign = bit 3)."""
+  x = x_int4.astype(jnp.float32)  # two's complement: -8..7
+  neg = x < 0
+  m = jnp.where(neg, x + 8.0, x)  # magnitude code 0..7
+  val = jnp.where(m < 4.0, m * 0.5, jnp.where(m < 6.0, m - 2.0, m * 2.0 - 8.0))
+  return jnp.where(neg, -val, val).astype(dtype)
+
+
+# Set by callers that store fp4 (e2m1) weights as int4 bits ahead of time
+# (one bitcast at load) so the per-call f4->int4 bitcast, which relayouts the
+# whole weight on TPU, is avoided. int4 rhs is then decoded as e2m1.
+INT4_RHS_IS_E2M1 = False
+# rhs_scale may be [group, num_blocks, n] (compact) with e2m1 weights.
+SCALE_COMPACT_OK = True
+# Compact ([group, rows, n]) scales are NVFP4 per-16 block scales; rows may be
+# padded past size_k // 16.
+E2M1_SCALE_BLOCK = 16
+
+
+def _needs_e2m1_emulation(rhs_dtype) -> bool:
+  if jnp.dtype(rhs_dtype) != jnp.dtype(jnp.float4_e2m1fn):
+    return False
+  gen = getattr(pltpu.get_tpu_info(), "generation", None)
+  return type(gen) is int and gen < 7
 
 
