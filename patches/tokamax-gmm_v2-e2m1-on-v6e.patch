# Patch for tokamax 0.0.18.dev20261107, file gmm_v2.py (the gmm_v2 grouped-matmul kernel).
# It also applies (line offsets only) to 0.0.18.dev20261029, the version requirements.txt pins.
# v6e has no fp4 vectors. The patch carries fp4 (e2m1) expert weights as int4 bits and decodes them
# to bf16 in VMEM. The NVFP4 MoE path for qwen4_exp needs it. Apply: patch <installed gmm_v2.py> < this file
--- gmm_v2.orig.py	2026-11-13 13:07:29
+++ gmm_v2.py	2026-11-13 15:22:39
@@ -185,6 +185,11 @@
   def get_scale(self, replicate_size: int | None = None) -> jax.Array:
     assert self.scale is not None
     if replicate_size is not None:
+      if jax.dtypes.itemsize_bits(self.scale.dtype) < 32:
+        # Zero-stride loads are not supported for packed (16-bit) types:
+        # load the (blocks, 1, n) tile, widen, then broadcast in registers.
+        s = self.scale[...].astype(jnp.float32)
+        return jnp.broadcast_to(s, (s.shape[0], replicate_size, s.shape[2]))
       # Perform zero-stride load for efficient broadcasting across sublanes.
       return self.scale[:, pl.ds(0, replicate_size, 0), :]
     return self.scale[...]
@@ -279,6 +284,9 @@
   # unquantized (dtype != quant_dtype) the scale quantizes it online (lhs).
   has_scale: bool = False
   is_transposed: bool = False
+  # fp4 (e2m1) weights carried as int4 bits on TPUs without native fp4
+  # vectors (v6e and older); decoded to the lhs dtype in VMEM.
+  e2m1_as_int4: bool = False
 
   @property
   def should_unpack(self) -> bool:
@@ -306,6 +314,8 @@
     """Dequantize rhs before matmul if block size limits MXU utilization."""
     if not self.has_scale:
       return False
+    if self.e2m1_as_int4:
+      return True
     assert self.quant_block_size is not None
     mxu_size = pltpu.get_tpu_info().mxu_column_size
     return self.quant_block_size < mxu_size
@@ -319,8 +329,30 @@
     if self.quant_dtype is None:
       return False
     return self.quant_dtype != self.dtype
+
